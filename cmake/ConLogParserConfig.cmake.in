@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)
find_dependency(TBB)
find_dependency(nlohmann_json 3.12)

find_dependency(PkgConfig)
if(NOT TARGET PkgConfig::SDBUS)
    pkg_check_modules(SDBUS REQUIRED IMPORTED_TARGET sdbus-c++)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ConLogParserTargets.cmake")

check_required_components(ConLogParser)
